    def nugget(self) -> float: ...
    @property
    def structures(self) -> list[Structure]: ...
    @property
    def rotation(self) -> tuple[float, float, float]: ...
    @property
    def ratios(self) -> tuple[float, float]: ...
    @property
    def sill(self) -> float: ...
